# Copy this file to .env and replace the value before deploying.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# The first administrator is created automatically only when users.json is empty.
BOOTSTRAP_ADMIN_NAME=NGOFlow Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@ngoflow.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
